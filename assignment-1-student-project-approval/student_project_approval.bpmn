<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_StudentProjectApproval" targetNamespace="http://camunda.org/schema/1.0/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collaboration_StudentProject">
    <bpmn:participant id="Participant_ProjectProgramme" name="Final-Year Student Project Approval &#38; Allocation Programme" processRef="Process_StudentProjectApproval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_StudentProjectApproval" name="Student Project Approval &#38; Allocation System" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Student" name="Student / Team">
        <bpmn:flowNodeRef>Start_ProposalInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidationRetryLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TeamRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyStudentAndGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProjectAllocated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_SubmissionDeadline</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Project Management System">
        <bpmn:flowNodeRef>Gateway_ValidationCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CompensationThrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordAllocation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SystemFailRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunSimilarityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SimilarityThreshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_ValidationSystemFailure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinator" name="Project Coordinator">
        <bpmn:flowNodeRef>Task_ReviewSimilarityMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DuplicateDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveLateSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CoordinatorValidationEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RevisionCount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>Gateway_RejectionAllowedAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CommitteeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_CommitteeSLA_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_CommitteeSLA_Escalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_GuideAllocation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>End_ReminderSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCommitteeReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoDIntervention</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ProposalInitiated" name="Team Decides to Submit Proposal">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitProposal" name="Submit Project Proposal" camunda:formKey="embedded:deployment:student_proposal_form.form">
      <bpmn:documentation>Student team inputs project title, domain, abstract, team members (size 2-4), roll numbers, and preliminary tech stack.</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_RevisionLoop</bpmn:incoming>
      <bpmn:incoming>Flow_ValidationRetry</bpmn:incoming>
      <bpmn:incoming>Flow_NewTopicAllowed</bpmn:incoming>
      <bpmn:incoming>Flow_LateApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewSimilarityMatch" name="Review Plagiarism / Match Report (F3)">
      <bpmn:incoming>Flow_SimilarityHigh</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DuplicateDecision" name="Coordinator Decision?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_DuplicateModify</bpmn:outgoing>
      <bpmn:outgoing>Flow_DuplicateReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_RejectionAllowedAttempts" name="1 Re-submission Allowed? (F6)">
      <bpmn:incoming>Flow_DecisionRejected</bpmn:incoming>
      <bpmn:incoming>Flow_DuplicateReject</bpmn:incoming>
      <bpmn:incoming>Flow_RevisionLimitExceeded</bpmn:incoming>
      <bpmn:outgoing>Flow_NewTopicAllowed</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinalRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ValidationCheck" name="Validation Result?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidationValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationInvalidTeam</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationFieldsIncomplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="BoundaryTimer_SubmissionDeadline" name="Deadline Approaching / Lapsed (F4)" cancelActivity="false" attachedToRef="Task_SubmitProposal">
      <bpmn:outgoing>Flow_DeadlineAlert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Deadline">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_ProposalInitiated" targetRef="Task_SubmitProposal" />
    <bpmn:sequenceFlow id="Flow_ValidationRetry" name="Retry (&#60; 2)" sourceRef="Gateway_ValidationRetryLimit" targetRef="Task_SubmitProposal" />
    <bpmn:sequenceFlow id="Flow_LateApproved" sourceRef="Task_ApproveLateSubmission" targetRef="Task_SubmitProposal" />
    <bpmn:sequenceFlow id="Flow_RevisionLoop" name="Resubmit within 7 days" sourceRef="Gateway_RevisionCount" targetRef="Task_SubmitProposal" />
    <bpmn:sequenceFlow id="Flow_NewTopicAllowed" name="1 New Topic Resubmission Allowed" sourceRef="Gateway_RejectionAllowedAttempts" targetRef="Task_SubmitProposal" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitProposal" targetRef="Task_ValidateProposal" />
    <bpmn:sequenceFlow id="Flow_DeadlineAlert" sourceRef="BoundaryTimer_SubmissionDeadline" targetRef="Task_ApproveLateSubmission" />
    <bpmn:sequenceFlow id="Flow_SysRetrySuccess" sourceRef="Task_SystemFailRetry" targetRef="Task_ValidateProposal" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidateProposal" targetRef="Gateway_ValidationCheck" />
    <bpmn:sequenceFlow id="Flow_ValidationFieldsIncomplete" name="Incomplete Fields (F1)" sourceRef="Gateway_ValidationCheck" targetRef="Gateway_ValidationRetryLimit" />
    <bpmn:sequenceFlow id="Flow_ValidationExceeded" name="Retries Exceeded" sourceRef="Gateway_ValidationRetryLimit" targetRef="Task_CoordinatorValidationEscalation" />
    <bpmn:sequenceFlow id="Flow_CoordinatorValidated" sourceRef="Task_CoordinatorValidationEscalation" targetRef="Task_ScreenProposal" />
    <bpmn:sequenceFlow id="Flow_ValidationValid" name="Valid" sourceRef="Gateway_ValidationCheck" targetRef="Task_ScreenProposal" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ScreenProposal" targetRef="Task_RunSimilarityCheck" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_RunSimilarityCheck" targetRef="Gateway_SimilarityThreshold" />
    <bpmn:sequenceFlow id="Flow_SimilarityLow" name="Original (&#60;=30%)" sourceRef="Gateway_SimilarityThreshold" targetRef="Task_EvaluateProposal" />
    <bpmn:sequenceFlow id="Flow_SimilarityHigh" name="High Match (F3)" sourceRef="Gateway_SimilarityThreshold" targetRef="Task_ReviewSimilarityMatch" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ReviewSimilarityMatch" targetRef="Gateway_DuplicateDecision" />
    <bpmn:sequenceFlow id="Flow_DuplicateModify" name="Request Topic Modification" sourceRef="Gateway_DuplicateDecision" targetRef="Gateway_RevisionCount" />
    <bpmn:sequenceFlow id="Flow_DuplicateReject" name="Plagiarism Reject" sourceRef="Gateway_DuplicateDecision" targetRef="Gateway_RejectionAllowedAttempts" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_EvaluateProposal" targetRef="Gateway_CommitteeDecision" />
    <bpmn:sequenceFlow id="Flow_SendReminder" sourceRef="BoundaryTimer_CommitteeSLA_Reminder" targetRef="Task_SendCommitteeReminder" />
    <bpmn:sequenceFlow id="Flow_ReminderSent" sourceRef="Task_SendCommitteeReminder" targetRef="End_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_EscalateHoD" sourceRef="BoundaryTimer_CommitteeSLA_Escalation" targetRef="Task_HoDIntervention" />
    <bpmn:sequenceFlow id="Flow_HoDDecided" sourceRef="Task_HoDIntervention" targetRef="Gateway_CommitteeDecision" />
    <bpmn:sequenceFlow id="Flow_DecisionApproved" name="Approved" sourceRef="Gateway_CommitteeDecision" targetRef="SubProcess_GuideAllocation" />
    <bpmn:sequenceFlow id="Flow_DecisionRevise" name="Revision Needed (F5)" sourceRef="Gateway_CommitteeDecision" targetRef="Gateway_RevisionCount" />
    <bpmn:sequenceFlow id="Flow_DecisionRejected" name="Rejected (F6)" sourceRef="Gateway_CommitteeDecision" targetRef="Gateway_RejectionAllowedAttempts" />
    <bpmn:sequenceFlow id="Flow_RevisionLimitExceeded" name="Revision Limit Exceeded" sourceRef="Gateway_RevisionCount" targetRef="Gateway_RejectionAllowedAttempts" />
    <bpmn:sequenceFlow id="Flow_FinalRejection" name="Hard Reject" sourceRef="Gateway_RejectionAllowedAttempts" targetRef="End_TeamRejected" />
    <bpmn:sequenceFlow id="Flow_ValidationInvalidTeam" name="Team Rule Violation (F2)" sourceRef="Gateway_ValidationCheck" targetRef="End_InvalidTeam" />
    <bpmn:sequenceFlow id="Flow_SysError" sourceRef="BoundaryError_ValidationSystemFailure" targetRef="Task_SystemFailRetry" />
    <bpmn:sequenceFlow id="Flow_AllocationComplete" sourceRef="SubProcess_GuideAllocation" targetRef="Task_RecordAllocation" />
    <bpmn:sequenceFlow id="Flow_WithdrawalInitiated" sourceRef="BoundaryMessage_Withdrawal" targetRef="Event_CompensationThrow" />
    <bpmn:sequenceFlow id="Flow_ToWithdrawnEnd" sourceRef="Event_CompensationThrow" targetRef="End_Withdrawn" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_RecordAllocation" targetRef="Task_NotifyStudentAndGuide" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_NotifyStudentAndGuide" targetRef="End_ProjectAllocated" />
    <bpmn:endEvent id="End_InvalidTeam" name="Rejected: Invalid Team Composition (F2)">
      <bpmn:incoming>Flow_ValidationInvalidTeam</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_InvalidTeam" errorRef="Error_InvalidTeamRule" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_ValidationRetryLimit" name="Retry Count &#60; 2? (F1)">
      <bpmn:incoming>Flow_ValidationFieldsIncomplete</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidationRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationExceeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_TeamRejected" name="Proposal Rejected (F6)">
      <bpmn:incoming>Flow_FinalRejection</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateDef_Reject" />
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyStudentAndGuide" name="Notify Student Team &#38; Faculty Guide" camunda:type="external" camunda:topic="notification-dispatcher">
      <bpmn:documentation>Dispatches official allocation order letter with reporting instructions to student and guide.</bpmn:documentation>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="Event_CompensationThrow" name="Compensate Guide Quota (F11)">
      <bpmn:incoming>Flow_WithdrawalInitiated</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWithdrawnEnd</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateDef_Withdraw" activityRef="SubProcess_GuideAllocation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Withdrawn" name="Process Terminated: Withdrawn (F11)">
      <bpmn:incoming>Flow_ToWithdrawnEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_RecordAllocation" name="Record Allocation in Master Register" camunda:type="external" camunda:topic="record-allocation-db">
      <bpmn:documentation>Persists confirmed project title, student team, and allocated faculty guide in official database.</bpmn:documentation>
      <bpmn:incoming>Flow_AllocationComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ProjectAllocated" name="Project Allocated &#38; Formally Confirmed">
      <bpmn:incoming>Flow_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SystemFailRetry" name="Execute Retry / Fallback Logger (F10)" camunda:type="external" camunda:topic="sys-retry-handler">
      <bpmn:incoming>Flow_SysError</bpmn:incoming>
      <bpmn:outgoing>Flow_SysRetrySuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ValidateProposal" name="Validate Form &#38; Team Rules (F1, F2)" camunda:type="external" camunda:topic="validate-proposal-rules">
      <bpmn:documentation>Automated check: non-empty abstract, team size 2..4, no duplicate student registration in another team, valid roll numbers.</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_SysRetrySuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryError_ValidationSystemFailure" name="System / DB Error (F10)" attachedToRef="Task_ValidateProposal">
      <bpmn:outgoing>Flow_SysError</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Sys" errorRef="Error_SystemUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_RunSimilarityCheck" name="Check Duplicate Topic &#38; Plagiarism (F3)" camunda:type="external" camunda:topic="topic-similarity-engine">
      <bpmn:documentation>Executes semantic similarity comparison against previous 5 years project repository.</bpmn:documentation>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SimilarityThreshold" name="Similarity &#62; 30%? (F3)">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_SimilarityLow</bpmn:outgoing>
      <bpmn:outgoing>Flow_SimilarityHigh</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ApproveLateSubmission" name="Review Late Submission Request (F4)">
      <bpmn:documentation>Coordinator reviews justification for late submission and grants an extension or dismisses.</bpmn:documentation>
      <bpmn:incoming>Flow_DeadlineAlert</bpmn:incoming>
      <bpmn:outgoing>Flow_LateApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ScreenProposal" name="Screen Proposal Scope &#38; Eligibility">
      <bpmn:documentation>Coordinator reviews preliminary department syllabus alignment and prerequisite coursework.</bpmn:documentation>
      <bpmn:incoming>Flow_ValidationValid</bpmn:incoming>
      <bpmn:incoming>Flow_CoordinatorValidated</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CoordinatorValidationEscalation" name="Resolve Validation Defect (F1)">
      <bpmn:documentation>Coordinator manually intervenes when automated validation repeatedly fails due to administrative edge cases.</bpmn:documentation>
      <bpmn:incoming>Flow_ValidationExceeded</bpmn:incoming>
      <bpmn:outgoing>Flow_CoordinatorValidated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RevisionCount" name="Revision Cycles &#60; 2? (F5)">
      <bpmn:incoming>Flow_DecisionRevise</bpmn:incoming>
      <bpmn:incoming>Flow_DuplicateModify</bpmn:incoming>
      <bpmn:outgoing>Flow_RevisionLoop</bpmn:outgoing>
      <bpmn:outgoing>Flow_RevisionLimitExceeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ReminderSent" name="Reminder Dispatched">
      <bpmn:incoming>Flow_ReminderSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendCommitteeReminder" name="Send Evaluation Reminder (F7)" camunda:type="external" camunda:topic="notification-dispatcher">
      <bpmn:incoming>Flow_SendReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_ReminderSent</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_HoDIntervention" name="HoD Emergency Review &#38; Direct Decision (F7)">
      <bpmn:documentation>Head of Department overrides delayed committee review and renders binding verdict.</bpmn:documentation>
      <bpmn:incoming>Flow_EscalateHoD</bpmn:incoming>
      <bpmn:outgoing>Flow_HoDDecided</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EvaluateProposal" name="Evaluate Proposal (Review Committee)" camunda:formKey="embedded:deployment:committee_evaluation_form.form">
      <bpmn:documentation>Review Committee evaluates innovation, feasibility, technical depth, and resource requirements.</bpmn:documentation>
      <bpmn:incoming>Flow_SimilarityLow</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryTimer_CommitteeSLA_Reminder" name="3-Day SLA Warning (F7)" cancelActivity="false" attachedToRef="Task_EvaluateProposal">
      <bpmn:outgoing>Flow_SendReminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Remind">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryTimer_CommitteeSLA_Escalation" name="7-Day SLA Breached (F7)" attachedToRef="Task_EvaluateProposal">
      <bpmn:outgoing>Flow_EscalateHoD</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Escalate">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_CommitteeDecision" name="Committee Verdict?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_HoDDecided</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionRevise</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_GuideAllocation" name="Faculty Guide Allocation &#38; Acceptance Sub-Process">
      <bpmn:incoming>Flow_DecisionApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_AllocationComplete</bpmn:outgoing>
      <bpmn:startEvent id="Start_GuideAlloc" name="Start Allocation">
        <bpmn:outgoing>Flow_SP_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="Task_MatchGuideDMN" name="Evaluate Guide Availability &#38; Domain Match (F8)" camunda:decisionRef="decision_guide_allocation">
        <bpmn:documentation>Camunda DMN table evaluates domain match score, faculty rank capacity, and current active team count.</bpmn:documentation>
        <bpmn:incoming>Flow_SP_01</bpmn:incoming>
        <bpmn:incoming>Flow_GuideRetry</bpmn:incoming>
        <bpmn:outgoing>Flow_SP_02</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="Gateway_GuideAvailable" name="Guide Available? (F8)">
        <bpmn:incoming>Flow_SP_02</bpmn:incoming>
        <bpmn:outgoing>Flow_GuideFound</bpmn:outgoing>
        <bpmn:outgoing>Flow_NoGuideFound</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_ManualGuideAllocation" name="Coordinator Manual / Co-Guide Allocation (F8)">
        <bpmn:documentation>Coordinator manually assigns cross-department guide, adjunct industry mentor, or adds to queue.</bpmn:documentation>
        <bpmn:incoming>Flow_NoGuideFound</bpmn:incoming>
        <bpmn:outgoing>Flow_ManualGuideAssigned</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Task_AssignGuideSlot" name="Reserve Guide Slot" camunda:type="external" camunda:topic="reserve-guide-slot">
        <bpmn:incoming>Flow_GuideFound</bpmn:incoming>
        <bpmn:incoming>Flow_ManualGuideAssigned</bpmn:incoming>
        <bpmn:outgoing>Flow_SP_03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="Task_SendGuideRequest" name="Send Allocation Request to Guide" camunda:type="external" camunda:topic="guide-request-dispatcher">
        <bpmn:incoming>Flow_SP_03</bpmn:incoming>
        <bpmn:outgoing>Flow_SP_04</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="Task_GuideDecision" name="Accept / Decline Allocation Request (F9)">
        <bpmn:documentation>Faculty guide formally reviews team proposal and accepts or provides refusal reason.</bpmn:documentation>
        <bpmn:incoming>Flow_SP_04</bpmn:incoming>
        <bpmn:outgoing>Flow_SP_05</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="BoundaryTimer_GuideResponseTimeout" name="3-Day Guide Timeout (F9)" attachedToRef="Task_GuideDecision">
        <bpmn:outgoing>Flow_GuideTimeout</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerDef_GuideTimeout">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Gateway_GuideDecision" name="Guide Accepted?">
        <bpmn:incoming>Flow_SP_05</bpmn:incoming>
        <bpmn:outgoing>Flow_GuideAccepted</bpmn:outgoing>
        <bpmn:outgoing>Flow_GuideDeclined</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_GuideAttempts" name="Guide Attempts &#60; 3? (F9)">
        <bpmn:incoming>Flow_GuideDeclined</bpmn:incoming>
        <bpmn:incoming>Flow_GuideTimeout</bpmn:incoming>
        <bpmn:outgoing>Flow_GuideRetry</bpmn:outgoing>
        <bpmn:outgoing>Flow_GuideAttemptsExceeded</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_GuideConfirmed" name="Guide Formally Accepted">
