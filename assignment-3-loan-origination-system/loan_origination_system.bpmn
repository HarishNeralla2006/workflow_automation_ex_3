<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LoanOrigination" targetNamespace="http://camunda.org/schema/1.0/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collaboration_LoanOrigination">
    <bpmn:participant id="Participant_Bank" name="Retail &#38; Commercial Bank Loan Origination Engine" processRef="Process_LoanOrigination" />
    <bpmn:participant id="Participant_ExternalCreditBureau" name="External Credit Bureau (Experian / TransUnion / CIBIL)" />
    <bpmn:messageFlow id="MsgFlow_BureauRequest" name="Request Bureau Score" sourceRef="Task_CreditBureauRetrieval" targetRef="Participant_ExternalCreditBureau" />
    <bpmn:messageFlow id="MsgFlow_BureauResponse" name="Return Credit History &#38; Score" sourceRef="Participant_ExternalCreditBureau" targetRef="Task_CreditBureauRetrieval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_LoanOrigination" name="Loan Origination &#38; Approval System" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Loan">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Start_LoanApplicationSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitMissingDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveOfferAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_OfferValidity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ESignAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_SignReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoanDisbursed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ApplicationLapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferSignCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LoanOfficer" name="Loan Officer">
        <bpmn:flowNodeRef>Task_EvaluateCounterOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CounterOfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmploymentIncomeVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualKYCReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CoreBanking" name="Core Banking &#38; Automation Engine">
        <bpmn:flowNodeRef>Task_CheckDocCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelVerification_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KYCVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KYCResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreditBureauRetrieval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_BureauCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelVerification_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EligibilityRiskScoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskRouting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateLoanOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CreditRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CompensateWithdrawal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCustomerDisbursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BureauRetryHandler</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriter / Credit Committee">
        <bpmn:flowNodeRef>Gateway_UnderwriterDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeniorCommitteeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnderwriterReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance" name="Fraud &#38; Compliance Team">
        <bpmn:flowNodeRef>Task_AMLScreening</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AMLResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AMLTerminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_FraudInvestigation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Disbursement" name="Operations &#38; Disbursement">
        <bpmn:flowNodeRef>Gateway_CollateralValuation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_DisbursementExecution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_DisbursementFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldFundsOpsIntervention</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollateralValuation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_LoanApplicationSubmitted" name="Applicant Submits Loan Application" camunda:formKey="embedded:deployment:loan_application_form.form">
      <bpmn:outgoing>Flow_L_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_CheckDocCompleteness" name="Check Document Completeness (L1)" camunda:resultVariable="docCompletenessResult" camunda:decisionRef="decision_loan_eligibility">
      <bpmn:documentation>Checks identity proof, address proof, 6 months bank statement, salary slips/ITR.</bpmn:documentation>
      <bpmn:incoming>Flow_L_01</bpmn:incoming>
      <bpmn:incoming>Flow_DocsResubmitted</bpmn:incoming>
      <bpmn:outgoing>Flow_L_02</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_DocCheck" name="Documents Complete?">
      <bpmn:incoming>Flow_L_02</bpmn:incoming>
      <bpmn:outgoing>Flow_DocsComplete</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocsIncomplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ResubmitMissingDocs" name="Upload Missing Documents (L1)">
      <bpmn:incoming>Flow_DocsIncomplete</bpmn:incoming>
      <bpmn:outgoing>Flow_DocsResubmitted</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryTimer_DocTimeout" name="7-Day Resubmission Window Lapsed (L1)" attachedToRef="Task_ResubmitMissingDocs">
      <bpmn:outgoing>Flow_DocLapsed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_DocLapse">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:parallelGateway id="Gateway_ParallelVerification_Split" name="Fork Verification Streams">
      <bpmn:incoming>Flow_DocsComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_KYC</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Bureau</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Income</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_AML</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_KYCVerification" name="Automated KYC Identity Verification (L2)" camunda:type="external" camunda:topic="kyc-service">
      <bpmn:incoming>Flow_Fork_KYC</bpmn:incoming>
      <bpmn:outgoing>Flow_L_KYCResult</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_KYCResult" name="KYC Match?">
      <bpmn:incoming>Flow_L_KYCResult</bpmn:incoming>
      <bpmn:outgoing>Flow_KYCPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_KYCFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreditBureauRetrieval" name="Retrieve Bureau Score &#38; Report (L4)" camunda:type="external" camunda:topic="credit-bureau-connector">
      <bpmn:incoming>Flow_Fork_Bureau</bpmn:incoming>
      <bpmn:incoming>Flow_BureauRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_BureauSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryError_BureauCall" name="Bureau API Timeout / Down (L4)" attachedToRef="Task_CreditBureauRetrieval">
      <bpmn:outgoing>Flow_BureauError</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Bureau" errorRef="Error_BureauUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_AMLScreening" name="AML &#38; PEP Sanctions Screening (L3)" camunda:type="external" camunda:topic="aml-screening">
      <bpmn:incoming>Flow_Fork_AML</bpmn:incoming>
      <bpmn:outgoing>Flow_AMLResult</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AMLResult" name="AML Flag Detected? (L3)">
      <bpmn:incoming>Flow_AMLResult</bpmn:incoming>
      <bpmn:outgoing>Flow_AMLClean</bpmn:outgoing>
      <bpmn:outgoing>Flow_AMLHit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_ParallelVerification_Join" name="Synchronize Verifications">
      <bpmn:incoming>Flow_KYCPassed</bpmn:incoming>
      <bpmn:incoming>Flow_BureauManualSuccess</bpmn:incoming>
      <bpmn:incoming>Flow_AMLClean</bpmn:incoming>
      <bpmn:incoming>Flow_0oj337u</bpmn:incoming>
      <bpmn:incoming>Flow_0rl0znd</bpmn:incoming>
      <bpmn:outgoing>Flow_VerificationSynchronized</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="Task_EligibilityRiskScoring" name="DMN Eligibility &#38; Risk Tier Calculation (L5, L6, L7)" camunda:decisionRef="decision_loan_eligibility">
      <bpmn:incoming>Flow_VerificationSynchronized</bpmn:incoming>
      <bpmn:incoming>Flow_CounterOfferReScored</bpmn:incoming>
      <bpmn:outgoing>Flow_RiskEvaluated</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_RiskRouting" name="Credit Policy Route?">
      <bpmn:incoming>Flow_RiskEvaluated</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteReject</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteCounterOffer</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteSeniorCommittee</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EvaluateCounterOffer" name="Formulate Counter-Offer (Guarantor / Lower Loan) (L5, L6)">
      <bpmn:incoming>Flow_RouteCounterOffer</bpmn:incoming>
      <bpmn:outgoing>Flow_CounterOfferEvaluated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CounterOfferAccepted" name="Counter-Offer Accepted?">
      <bpmn:incoming>Flow_CounterOfferEvaluated</bpmn:incoming>
      <bpmn:outgoing>Flow_CounterOfferReScored</bpmn:outgoing>
      <bpmn:outgoing>Flow_CounterOfferRefused</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_CreditRejected" name="Loan Application Rejected (L5)">
      <bpmn:incoming>Flow_RouteReject</bpmn:incoming>
      <bpmn:incoming>Flow_CounterOfferRefused</bpmn:incoming>
      <bpmn:incoming>Flow_UnderwriterRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_CollateralValuation" name="Title &#38; LTV Acceptable? (L8)">
      <bpmn:incoming>Flow_CollateralChecked</bpmn:incoming>
      <bpmn:outgoing>Flow_CollateralApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_CollateralDefectReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_GenerateLoanOffer" name="Generate Sanction Letter &#38; Repayment Schedule" scriptFormat="javascript">
      <bpmn:incoming>Flow_SanctionApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferGenerated</bpmn:outgoing>
      <bpmn:script>
        execution.setVariable("offerSanctionId", "SANCT-" + java.util.UUID.randomUUID().toString().substring(0,8));
        execution.setVariable("interestRate", 8.5);
        execution.setVariable("offerValidityDays", 15);
      </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sendTask id="Task_SendOffer" name="Dispatch Loan Offer to Applicant" camunda:type="external" camunda:topic="offer-dispatcher">
      <bpmn:incoming>Flow_OfferGenerated</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferSent</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveOfferAcceptance" name="Receive Applicant Offer Decision (L9, L10)" messageRef="Message_OfferDecision">
      <bpmn:incoming>Flow_OfferSent</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferAccepted</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryTimer_OfferValidity" name="15-Day Offer Validity Lapsed (L9)" attachedToRef="Task_ReceiveOfferAcceptance">
      <bpmn:outgoing>Flow_OfferLapsed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_OfferValidity">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryMessage_ApplicantWithdrawal" name="Applicant Cancels / Withdraws (L10)" attachedToRef="Task_ReceiveOfferAcceptance">
      <bpmn:outgoing>Flow_WithdrawalReceived</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Withdraw" messageRef="Message_LoanWithdrawal" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Event_CompensateWithdrawal" name="Compensate Processing Fee &#38; Release Holds (L10)">
      <bpmn:incoming>Flow_WithdrawalReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_WithdrawnEnd</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateDef_Loan" activityRef="Task_EligibilityRiskScoring" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Withdrawn" name="Application Closed: Withdrawn (L10)">
      <bpmn:incoming>Flow_WithdrawnEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ESignAgreement" name="E-Sign Loan Agreement (L11)">
      <bpmn:documentation>Applicant enters digital signature via Aadhaar e-Sign / DocuSign token.</bpmn:documentation>
      <bpmn:incoming>Flow_OfferAccepted</bpmn:incoming>
      <bpmn:outgoing>Flow_AgreementSigned</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryTimer_SignReminder" name="48h E-Sign Timeout (L11)" attachedToRef="Task_ESignAgreement">
      <bpmn:outgoing>Flow_SignFailed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Sign">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_LoanDisbursed" name="Loan Disbursed &#38; Account Active">
      <bpmn:incoming>Flow_FinalDelivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L_01" sourceRef="Start_LoanApplicationSubmitted" targetRef="Task_CheckDocCompleteness" />
    <bpmn:sequenceFlow id="Flow_L_02" sourceRef="Task_CheckDocCompleteness" targetRef="Gateway_DocCheck" />
    <bpmn:sequenceFlow id="Flow_DocsComplete" name="Yes" sourceRef="Gateway_DocCheck" targetRef="Gateway_ParallelVerification_Split" />
    <bpmn:sequenceFlow id="Flow_DocsIncomplete" name="Missing / Blurry (L1)" sourceRef="Gateway_DocCheck" targetRef="Task_ResubmitMissingDocs" />
    <bpmn:sequenceFlow id="Flow_DocsResubmitted" sourceRef="Task_ResubmitMissingDocs" targetRef="Task_CheckDocCompleteness" />
    <bpmn:sequenceFlow id="Flow_DocLapsed" sourceRef="BoundaryTimer_DocTimeout" targetRef="End_ApplicationLapsed" />
    <bpmn:sequenceFlow id="Flow_Fork_KYC" sourceRef="Gateway_ParallelVerification_Split" targetRef="Task_KYCVerification" />
    <bpmn:sequenceFlow id="Flow_Fork_Bureau" sourceRef="Gateway_ParallelVerification_Split" targetRef="Task_CreditBureauRetrieval" />
    <bpmn:sequenceFlow id="Flow_Fork_Income" sourceRef="Gateway_ParallelVerification_Split" targetRef="Task_EmploymentIncomeVerification" />
    <bpmn:sequenceFlow id="Flow_Fork_AML" sourceRef="Gateway_ParallelVerification_Split" targetRef="Task_AMLScreening" />
    <bpmn:sequenceFlow id="Flow_L_KYCResult" sourceRef="Task_KYCVerification" targetRef="Gateway_KYCResult" />
    <bpmn:sequenceFlow id="Flow_KYCPassed" name="Match" sourceRef="Gateway_KYCResult" targetRef="Gateway_ParallelVerification_Join" />
    <bpmn:sequenceFlow id="Flow_KYCFailed" name="Mismatch (L2)" sourceRef="Gateway_KYCResult" targetRef="Task_ManualKYCReview" />
    <bpmn:sequenceFlow id="Flow_BureauSuccess" sourceRef="Task_CreditBureauRetrieval" targetRef="Task_BureauRetryHandler" />
    <bpmn:sequenceFlow id="Flow_BureauError" sourceRef="BoundaryError_BureauCall" targetRef="Task_BureauRetryHandler" />
    <bpmn:sequenceFlow id="Flow_BureauRetry" sourceRef="Task_BureauRetryHandler" targetRef="Task_CreditBureauRetrieval" />
    <bpmn:sequenceFlow id="Flow_BureauRetryHandlerFallback" sourceRef="Task_BureauRetryHandler" targetRef="Task_ManualBureauLookup" />
    <bpmn:sequenceFlow id="Flow_BureauManualSuccess" sourceRef="Task_ManualBureauLookup" targetRef="Gateway_ParallelVerification_Join" />
    <bpmn:sequenceFlow id="Flow_IncomeVerified" sourceRef="Task_EmploymentIncomeVerification" targetRef="Task_ManualKYCReview" />
    <bpmn:sequenceFlow id="Flow_AMLResult" sourceRef="Task_AMLScreening" targetRef="Gateway_AMLResult" />
    <bpmn:sequenceFlow id="Flow_AMLClean" name="Clean" sourceRef="Gateway_AMLResult" targetRef="Gateway_ParallelVerification_Join" />
    <bpmn:sequenceFlow id="Flow_AMLHit" name="Hit (L3)" sourceRef="Gateway_AMLResult" targetRef="SubProcess_FraudInvestigation" />
    <bpmn:sequenceFlow id="Flow_FraudConfirmed" sourceRef="SubProcess_FraudInvestigation" targetRef="End_AMLTerminate" />
    <bpmn:sequenceFlow id="Flow_VerificationSynchronized" sourceRef="Gateway_ParallelVerification_Join" targetRef="Task_EligibilityRiskScoring" />
    <bpmn:sequenceFlow id="Flow_RiskEvaluated" sourceRef="Task_EligibilityRiskScoring" targetRef="Gateway_RiskRouting" />
    <bpmn:sequenceFlow id="Flow_RouteReject" name="Score &#60; Cutoff (L5)" sourceRef="Gateway_RiskRouting" targetRef="End_CreditRejected" />
    <bpmn:sequenceFlow id="Flow_RouteCounterOffer" name="High DTI (L6)" sourceRef="Gateway_RiskRouting" targetRef="Task_EvaluateCounterOffer" />
    <bpmn:sequenceFlow id="Flow_CounterOfferEvaluated" sourceRef="Task_EvaluateCounterOffer" targetRef="Gateway_CounterOfferAccepted" />
    <bpmn:sequenceFlow id="Flow_CounterOfferReScored" name="Accepted" sourceRef="Gateway_CounterOfferAccepted" targetRef="Task_EligibilityRiskScoring" />
    <bpmn:sequenceFlow id="Flow_CounterOfferRefused" name="Refused" sourceRef="Gateway_CounterOfferAccepted" targetRef="End_CreditRejected" />
    <bpmn:sequenceFlow id="Flow_RouteSeniorCommittee" name="Borderline / &#62; Limit (L7)" sourceRef="Gateway_RiskRouting" targetRef="Task_UnderwriterReview" />
    <bpmn:sequenceFlow id="Flow_SeniorDone" sourceRef="Task_SeniorCommitteeReview" targetRef="Task_UnderwriterReview" />
    <bpmn:sequenceFlow id="Flow_UnderwriterDecided" sourceRef="Task_UnderwriterReview" targetRef="Gateway_UnderwriterDecision" />
    <bpmn:sequenceFlow id="Flow_SanctionApproved" name="Approved" sourceRef="Gateway_UnderwriterDecision" targetRef="Task_GenerateLoanOffer" />
    <bpmn:sequenceFlow id="Flow_UnderwriterRejected" name="Rejected" sourceRef="Gateway_UnderwriterDecision" targetRef="End_CreditRejected" />
    <bpmn:sequenceFlow id="Flow_NeedCollateralValuation" name="Secured Loan (L8)" sourceRef="Gateway_UnderwriterDecision" targetRef="Task_CollateralValuation" />
    <bpmn:sequenceFlow id="Flow_CollateralChecked" sourceRef="Task_CollateralValuation" targetRef="Gateway_CollateralValuation" />
    <bpmn:sequenceFlow id="Flow_CollateralApproved" name="Valuation OK" sourceRef="Gateway_CollateralValuation" targetRef="Task_UnderwriterReview" />
    <bpmn:sequenceFlow id="Flow_CollateralDefectReject" name="Defective Title (L8)" sourceRef="Gateway_CollateralValuation" targetRef="End_CreditRejected" />
    <bpmn:sequenceFlow id="Flow_OfferGenerated" sourceRef="Task_GenerateLoanOffer" targetRef="Task_SendOffer" />
    <bpmn:sequenceFlow id="Flow_OfferSent" sourceRef="Task_SendOffer" targetRef="Task_ReceiveOfferAcceptance" />
    <bpmn:sequenceFlow id="Flow_OfferAccepted" sourceRef="Task_ReceiveOfferAcceptance" targetRef="Task_ESignAgreement" />
    <bpmn:sequenceFlow id="Flow_OfferLapsed" sourceRef="BoundaryTimer_OfferValidity" targetRef="End_OfferExpired" />
    <bpmn:sequenceFlow id="Flow_WithdrawalReceived" sourceRef="BoundaryMessage_ApplicantWithdrawal" targetRef="Event_CompensateWithdrawal" />
    <bpmn:sequenceFlow id="Flow_WithdrawnEnd" sourceRef="Event_CompensateWithdrawal" targetRef="End_Withdrawn" />
    <bpmn:sequenceFlow id="Flow_AgreementSigned" sourceRef="Task_ESignAgreement" targetRef="SubProcess_DisbursementExecution" />
    <bpmn:sequenceFlow id="Flow_SignFailed" sourceRef="BoundaryTimer_SignReminder" targetRef="End_OfferSignCancelled" />
    <bpmn:sequenceFlow id="Flow_DisbursementSuccess" sourceRef="SubProcess_DisbursementExecution" targetRef="Task_NotifyCustomerDisbursement" />
    <bpmn:sequenceFlow id="Flow_DisbErrorTrigger" sourceRef="BoundaryError_DisbursementFailed" targetRef="Task_HoldFundsOpsIntervention" />
    <bpmn:sequenceFlow id="Flow_DisbRetried" sourceRef="Task_HoldFundsOpsIntervention" targetRef="Task_NotifyCustomerDisbursement" />
    <bpmn:sequenceFlow id="Flow_FinalDelivered" sourceRef="Task_NotifyCustomerDisbursement" targetRef="End_LoanDisbursed" />
    <bpmn:endEvent id="End_ApplicationLapsed" name="Application Lapsed (L1)">
      <bpmn:incoming>Flow_DocLapsed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OfferExpired" name="Offer Expired / Cancelled (L9)">
      <bpmn:incoming>Flow_OfferLapsed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OfferSignCancelled" name="Agreement Cancelled (L11)">
      <bpmn:incoming>Flow_SignFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyCustomerDisbursement" name="Send Welcome Kit &#38; Repayment Kit" camunda:type="external" camunda:topic="notification-dispatcher">
      <bpmn:incoming>Flow_DisbursementSuccess</bpmn:incoming>
      <bpmn:incoming>Flow_DisbRetried</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalDelivered</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_AMLTerminate" name="Terminated: Fraud / Sanction Reject (L3)">
      <bpmn:incoming>Flow_FraudConfirmed</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateDef_AML" />
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_FraudInvestigation" name="Fraud &#38; Compliance Investigation Sub-Process (L3)">
      <bpmn:incoming>Flow_AMLHit</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudConfirmed</bpmn:outgoing>
      <bpmn:startEvent id="Start_FraudSP" />
      <bpmn:userTask id="Task_InvestigateSanctions" name="Investigate Sanctions Match / Document Forgery" />
      <bpmn:serviceTask id="Task_FileSARReport" name="File Suspicious Activity Report (SAR)" camunda:type="external" camunda:topic="file-sar" />
      <bpmn:endEvent id="End_FraudSP" />
      <bpmn:sequenceFlow id="Flow_FSP_1" sourceRef="Start_FraudSP" targetRef="Task_InvestigateSanctions" />
      <bpmn:sequenceFlow id="Flow_FSP_2" sourceRef="Task_InvestigateSanctions" targetRef="Task_FileSARReport" />
      <bpmn:sequenceFlow id="Flow_FSP_3" sourceRef="Task_FileSARReport" targetRef="End_FraudSP" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_UnderwriterDecision" name="Underwriter Sanction?">
      <bpmn:incoming>Flow_UnderwriterDecided</bpmn:incoming>
      <bpmn:outgoing>Flow_SanctionApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_UnderwriterRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedCollateralValuation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_DisbursementExecution" name="Disbursement &#38; Core Banking Sub-Process (L12)">
      <bpmn:incoming>Flow_AgreementSigned</bpmn:incoming>
      <bpmn:outgoing>Flow_DisbursementSuccess</bpmn:outgoing>
      <bpmn:startEvent id="Start_DisbSP" />
      <bpmn:serviceTask id="Task_VerifyAccountPennyDrop" name="Verify Bank Account (Penny Drop)" camunda:type="external" camunda:topic="account-validator" />
      <bpmn:serviceTask id="Task_CreateLoanAccount" name="Create Loan Master in CBS" camunda:type="external" camunda:topic="create-cbs-account" />
      <bpmn:serviceTask id="Task_ExecuteDisbursementNEFT" name="Execute NEFT / RTGS Transfer" camunda:type="external" camunda:topic="disburse-funds" />
      <bpmn:endEvent id="End_DisbSP" />
      <bpmn:sequenceFlow id="Flow_DSP_1" sourceRef="Start_DisbSP" targetRef="Task_VerifyAccountPennyDrop" />
      <bpmn:sequenceFlow id="Flow_DSP_2" sourceRef="Task_VerifyAccountPennyDrop" targetRef="Task_CreateLoanAccount" />
      <bpmn:sequenceFlow id="Flow_DSP_3" sourceRef="Task_CreateLoanAccount" targetRef="Task_ExecuteDisbursementNEFT" />
      <bpmn:sequenceFlow id="Flow_DSP_4" sourceRef="Task_ExecuteDisbursementNEFT" targetRef="End_DisbSP" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BoundaryError_DisbursementFailed" name="Payment Gateway Error (L12)" attachedToRef="SubProcess_DisbursementExecution">
      <bpmn:outgoing>Flow_DisbErrorTrigger</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Disbursement" errorRef="Error_PaymentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_HoldFundsOpsIntervention" name="Hold Funds &#38; Rectify Account (L12)">
      <bpmn:incoming>Flow_DisbErrorTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_DisbRetried</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0oj337u" sourceRef="Task_ManualKYCReview" targetRef="Gateway_ParallelVerification_Join" />
    <bpmn:userTask id="Task_EmploymentIncomeVerification" name="Verify Income &#38; Employer (L6)">
      <bpmn:incoming>Flow_Fork_Income</bpmn:incoming>
      <bpmn:outgoing>Flow_IncomeVerified</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ManualKYCReview" name="Manual KYC &#38; Bio Verification (L2)">
      <bpmn:documentation>Loan officer contacts applicant or requests notarized verification.</bpmn:documentation>
      <bpmn:incoming>Flow_KYCFailed</bpmn:incoming>
      <bpmn:incoming>Flow_IncomeVerified</bpmn:incoming>
      <bpmn:outgoing>Flow_0oj337u</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SeniorCommitteeReview" name="Senior Credit Committee Deliberation (L7)">
      <bpmn:incoming>Flow_1tafys5</bpmn:incoming>
      <bpmn:outgoing>Flow_SeniorDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1tafys5" sourceRef="Task_UnderwriterReview" targetRef="Task_SeniorCommitteeReview" />
    <bpmn:userTask id="Task_UnderwriterReview" name="Credit Underwriter Review &#38; Sanction" camunda:formKey="embedded:deployment:underwriter_review_form.form">
      <bpmn:incoming>Flow_SeniorDone</bpmn:incoming>
      <bpmn:incoming>Flow_CollateralApproved</bpmn:incoming>
      <bpmn:incoming>Flow_RouteSeniorCommittee</bpmn:incoming>
      <bpmn:outgoing>Flow_UnderwriterDecided</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tafys5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CollateralValuation" name="Collateral Inspection &#38; Title Verification (L8)">
      <bpmn:incoming>Flow_NeedCollateralValuation</bpmn:incoming>
      <bpmn:outgoing>Flow_CollateralChecked</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BureauRetryHandler" name="Retry Bureau Call (Max 3) (L4)" camunda:type="external" camunda:topic="bureau-retry">
      <bpmn:incoming>Flow_BureauError</bpmn:incoming>
      <bpmn:incoming>Flow_BureauSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_BureauRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_0rl0znd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0rl0znd" sourceRef="Task_BureauRetryHandler" targetRef="Gateway_ParallelVerification_Join" />
  </bpmn:process>
